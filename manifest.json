{
  "manifest_version": 3,
  "name": "JSON Studio",
  "version": "1.0.0",
  "description": "View, format, query and compare JSON, Python dicts and other dict-like data. Paste anything: stringified JSON, logs, Base64, JWT.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open in JSON Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "webNavigation", "storage"],
  "host_permissions": ["file:///*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
